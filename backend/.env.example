DATABASE_PATH=data/atchacha.db
UPLOAD_DIR=data/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=8
# 비워두면 DB 기반 문구를 사용합니다. 키는 서버에만 설정하세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 기본값은 실제 사진 분석. mock은 개발 테스트 전용입니다.
DETECTION_MODE=yolo
YOLO_MODEL_PATH=models/yolov8n.onnx
YOLO_CONFIDENCE=0.35

# 위험 설명 생성: 사진 원본은 Gemini에 전송하지 않습니다.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Local electrical detector (3 single-class queries; CPU roughly 20 seconds)
ELECTRICAL_DETECTION_ENABLED=true
ELECTRICAL_MODEL_DIR=models/grounding-dino
ELECTRICAL_BOX_THRESHOLD=0.35
ELECTRICAL_CPU_THREADS=2
REFERENCE_VERIFIER_ENABLED=true
REFERENCE_VERIFIER_PATH=models/reference_verifier.npz

# Photo editing is paid and opt-in. Keep disabled until billing/budget is configured.
INTERIOR_IMAGE_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Optional separate key; when omitted the server uses GEMINI_API_KEY.
